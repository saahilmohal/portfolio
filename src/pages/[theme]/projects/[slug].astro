---
import Base from '../../../components/Base.astro';
import EntryGallery from '../../../components/EntryGallery.astro';
import Documents from '../../../components/Documents.astro';
import { getProjects, yearOf, entryPhotos, THEMES, type Theme } from '../../../lib';
import { render } from 'astro:content';
export async function getStaticPaths() {
  const all = await getProjects();
  return THEMES.flatMap((theme) => all.map((entry, i) => ({ params: { theme, slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } })));
}
const theme = Astro.params.theme as Theme;
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const gallery = entryPhotos('projects', entry.id);
---
<Base theme={theme} title={d.title} description={d.summary} path={`/projects/${entry.id}`}>
  <Fragment slot="hero">
    <p class="eyebrow"><a href={`/${theme}/projects/`}>← Projects</a></p>
    <h2 class="page-title">{d.title}</h2>
    {d.kind && <p class="lede">{d.kind}</p>}
  </Fragment>
  <article class:list={["detail", { "has-media": gallery.length > 0 }]}>
    <aside class="facts">
      {d.logo && <div class="logo" style={d.logoBackground ? `background:${d.logoBackground}` : undefined}>{[d.logo].flat().map((src) => <img src={src} alt="Logo" loading="lazy" referrerpolicy="no-referrer" />)}</div>}
      <dl>
        {d.label && <div><dt>Type</dt><dd>{d.label}</dd></div>}
        {d.date && <div><dt>Started</dt><dd>{yearOf(d.date)}</dd></div>}
        {d.tags.length > 0 && <div><dt>Focus</dt><dd><ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul></dd></div>}
      </dl>
    </aside>
    <div class="prose">
      <p class="summary">{d.summary}</p>
      <Content />
      <Documents docs={d.documents} />
      {gallery.length > 0 && <div class="overflow-media" hidden><div class="photos"></div></div>}
    </div>
    {gallery.length > 0 && <aside class="side-media"><EntryGallery photos={gallery} /></aside>}
  </article>
  {next.id !== entry.id && <a class="next" href={`/${theme}/projects/${next.id}/`}><span>Next</span>{next.data.title} →</a>}
</Base>
