---
import { Image } from 'astro:assets';
import { photos, photoOrder } from '../lib';
interface Props { limit?: number }
const { limit } = Astro.props;
// In random mode every photo is sent to the page and shuffled in the browser,
// so the homepage preview shows a different set on each visit.
const list = photoOrder === 'random' || !limit ? photos : photos.slice(0, limit);
---
{list.length > 0
  ? <div class="photos" data-order={photoOrder} data-limit={limit ?? ''}>{list.map((p, i) => (
      <figure hidden={photoOrder === 'random' && !!limit && i >= limit}><Image src={p.src} alt={p.caption || 'Aerial photo'} widths={[400, 800, 1600]} sizes="(max-width: 760px) 50vw, 25vw" loading="lazy" />{p.caption && <figcaption>{p.caption}</figcaption>}</figure>
    ))}</div>
  : <div class="photos-empty">Drone photos go in the <b>src/photos</b> folder and appear here automatically.</div>}
