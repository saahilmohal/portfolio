---
import { Image } from 'astro:assets';
interface Props { photos: { src: ImageMetadata | string; caption: string; video?: boolean }[] }
const { photos } = Astro.props;
---
{photos.length > 0 && (
  <section class="entry-photos">
    <h2>Photos</h2>
    <div class:list={['photos', { few: photos.length < 3 }]}>{photos.map((p) => (
      <figure class:list={{ video: p.video }}>
        {p.video
          ? <video src={p.src as string} autoplay muted loop playsinline preload="metadata" aria-label={p.caption}></video>
          : <Image src={p.src as ImageMetadata} alt={p.caption || 'Project photo'} widths={[400, 800, 1600]} sizes="(max-width: 760px) 50vw, 33vw" loading="lazy" />}
        {p.caption && <figcaption>{p.caption}</figcaption>}
      </figure>
    ))}</div>
  </section>
)}
